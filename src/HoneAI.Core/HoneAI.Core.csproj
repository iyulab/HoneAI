<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>HoneAI.Core</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Assembly layer for HoneAI — a tiered, provenance-carrying decision pipeline behind the HoneAI.Abstractions contracts. Ships the tier router and settlement policy, the recheck sampler and trust ledger with the per-slice trust lifecycle, the JSONL provenance sink, the HTTP MLoop client, the review store and the train→review→promote lifecycle.</Description>
    <Company>iyulab</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/HoneAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/HoneAI</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mlops;ai-agent;provenance;hitl;mloop;llm;honeai</PackageTags>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- IMPORT BOUNDARY: HoneAI references downward only (HoneAI -> MLoop), never the
       reverse. MLoop is consumed over transport (HTTP/MCP), not duplicated and not
       referenced as a project. -->
  <ItemGroup>
    <ProjectReference Include="../HoneAI.Abstractions/HoneAI.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HoneAI.Tests" />
  </ItemGroup>
</Project>
