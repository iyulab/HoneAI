<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>HoneAI.Core</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Assembly layer for HoneAI — composes MLoop (L2 AutoML, over HTTP/MCP transport) and an IChatClient (L3 frontier) behind the HoneAI.Abstractions contracts. Ships the dual-check reasoning router, JSONL provenance sink, HTTP MLoop client, in-memory HITL gate, and train→review→promote lifecycle.</Description>
    <Company>iyulab</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/HoneAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/HoneAI</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mlops;ai-agent;provenance;hitl;mloop;llm;honeai</PackageTags>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- IMPORT BOUNDARY (§2.1, §6.1): HoneAI references downward only
       (HoneAI -> MLoop/agent), never the reverse. MLoop is consumed over
       transport (HTTP/MCP) per the consumer back-derivation, NOT duplicated.
       Phase 0 depends on Abstractions alone; the MLoop/IChatClient bindings
       arrive with the Phase 1 primitive extractions. -->
  <ItemGroup>
    <ProjectReference Include="../HoneAI.Abstractions/HoneAI.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HoneAI.Tests" />
  </ItemGroup>
</Project>
