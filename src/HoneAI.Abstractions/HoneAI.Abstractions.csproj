<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>HoneAI.Abstractions</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Contract surface for HoneAI — reasoning routing, prediction provenance, HITL, MLoop client, and lifecycle interfaces. Zero dependencies by design: "a prediction without provenance must not compile."</Description>
    <Company>iyulab</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/HoneAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/HoneAI</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mlops;ai-agent;provenance;hitl;abstractions;honeai</PackageTags>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- INVARIANT (enforced by HoneAI.Tests/ImportBoundaryTests):
       this project must carry ZERO package/project dependencies. It is the
       contract floor every consumer adapter and every assembly layer references. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HoneAI.Tests" />
  </ItemGroup>
</Project>
