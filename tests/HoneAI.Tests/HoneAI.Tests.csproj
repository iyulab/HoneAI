<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken): its code fix rewrites every awaited call
         and folds multi-line calls onto one line; these suites do not rely on cancelling a test. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Audit direct references only: HoneAI.Agents brings CVE-2025-6965 (NU1903) in transitively through IronHive.Agent. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HoneAI.Abstractions/HoneAI.Abstractions.csproj" />
    <ProjectReference Include="../../src/HoneAI.Core/HoneAI.Core.csproj" />
    <ProjectReference Include="../../src/HoneAI.Agents/HoneAI.Agents.csproj" />
  </ItemGroup>
</Project>
